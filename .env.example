# HTTP port. Railway sets this automatically; use it locally if you want.
PORT=8000

# Voice id in the form language-name-quality.
PIPER_VOICE=en_US-lessac-medium

# Directory that contains <voice>.onnx and <voice>.onnx.json.
# In Docker this is /app/models. Locally you can leave it as the project root.
PIPER_MODEL_DIR=.

# Optional explicit path to the ONNX file. Overrides PIPER_MODEL_DIR + PIPER_VOICE.
# PIPER_MODEL_PATH=./en_US-lessac-medium.onnx

# Download the voice at process startup if the files are missing.
# The Docker image already contains the voice, so production sets this to false.
DOWNLOAD_MISSING_VOICE=true

# Reject requests longer than this many characters.
MAX_TEXT_LENGTH=2000

# Serialize synthesis so concurrent requests cannot pile up ONNX memory use.
MAX_CONCURRENT_TTS=1

# Comma-separated browser origins allowed to call the API.
# Leave empty to send no CORS allow-origin header (server-to-server still works).
# Do not use * in production.
# Example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
